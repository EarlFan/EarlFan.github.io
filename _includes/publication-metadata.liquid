{% assign paper = page.publication %}
<meta name="citation_title" content="{{ page.title | escape }}">
{% for author in page.publication_authors %}
  <meta name="citation_author" content="{{ author | escape }}">
{% endfor %}
<meta name="citation_publication_date" content="{{ paper.year | escape }}">
{% if paper.journal %}
  <meta name="citation_journal_title" content="{{ paper.journal | escape }}">
{% endif %}
{% if paper.volume %}
  <meta name="citation_volume" content="{{ paper.volume | escape }}">
{% endif %}
{% if paper.number %}
  <meta name="citation_issue" content="{{ paper.number | escape }}">
{% endif %}
{% if paper.pages %}
  {% assign pages = paper.pages | split: '--' %}
  <meta name="citation_firstpage" content="{{ pages.first | escape }}">
  {% if pages.size > 1 %}
    <meta name="citation_lastpage" content="{{ pages.last | escape }}">
  {% endif %}
{% endif %}
{% if paper.doi %}
  <meta name="citation_doi" content="{{ paper.doi | escape }}">
{% endif %}
{% if page.publication_pdf_url %}
  <meta name="citation_pdf_url" content="{{ page.publication_pdf_url | absolute_url | escape }}">
{% endif %}
